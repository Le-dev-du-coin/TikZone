# ==========================================
# MIKROOT BACKEND CONFIGURATION (.env)
# ==========================================

# Sécurité & Environnement
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-secret-key-for-mikroot-saas
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS & Frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base de Données (Par défaut SQLite pour dev rapide, PostgreSQL pour staging/prod)
# Exemple PostgreSQL: postgres://user:password@localhost:5432/mikroot_db
DATABASE_URL=sqlite:///db.sqlite3

# Domaine & Hébergement unifié
BASE_DOMAIN=tikzone.net

# Paramètres VPN Server
VPN_SERVER_HOST=vpn.tikzone.net
VPN_SUBNET=172.29.88.0/24
VPN_API_PORT_START=41000
VPN_WINBOX_PORT_START=51000

